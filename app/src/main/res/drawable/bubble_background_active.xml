<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <!-- Active/listening state: bright centre fading to deep red -->
    <gradient
        android:type="radial"
        android:gradientRadius="32dp"
        android:startColor="#FFF0F0"
        android:centerColor="#99C62828"
        android:endColor="#FFB71C1C" />
    <stroke android:width="1.5dp" android:color="#55FFFFFF" />
</shape>
