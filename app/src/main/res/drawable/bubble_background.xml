<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <!-- Radial gradient: bright centre (淡色) fading to deep blue at the rim -->
    <gradient
        android:type="radial"
        android:gradientRadius="32dp"
        android:startColor="@color/bubble_bg_start"
        android:centerColor="@color/bubble_bg_center"
        android:endColor="@color/bubble_bg_end" />
    <stroke android:width="1.5dp" android:color="#55FFFFFF" />
</shape>
