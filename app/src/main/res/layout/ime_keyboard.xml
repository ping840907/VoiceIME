<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/ime_bg"
    android:paddingTop="6dp"
    android:paddingBottom="12dp">

    <!-- Fuzzy correction suggestions (near-miss matches against UserDictionary) -->
    <ScrollView
        android:id="@+id/scroll_suggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="44dp"
        android:background="@color/ime_preview_bg"
        android:visibility="gone"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/ll_suggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="4dp" />
    </ScrollView>

    <!-- Dual-Engine X-ASR Interim Text Display Area -->
    <LinearLayout
        android:id="@+id/layout_interim_display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_ime_interim"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="即時暫存 (X-ASR)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/ime_accent" />

            <TextView
                android:id="@+id/tv_interim_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="雙模型模式"
                android:textSize="10sp"
                android:textColor="@color/ime_status_text" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scroll_interim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="52dp"
            android:overScrollMode="ifContentScrolls">

            <TextView
                android:id="@+id/tv_interim_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/ime_key_text"
                android:lineSpacingExtra="2dp"
                android:text="聆聽中…" />
        </ScrollView>
    </LinearLayout>

    <!-- ── Top area: swaps between mic button and candidate chips ── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="84dp">

        <LinearLayout
            android:id="@+id/layout_mic_row"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:orientation="horizontal"
            android:gravity="center">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_ime_status_pill"
                android:backgroundTint="@color/ime_surface">

                <ImageButton
                    android:id="@+id/btn_mic"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_mic"
                    android:background="@drawable/mic_bg"
                    android:contentDescription="語音輸入"
                    android:scaleType="centerInside"
                    android:padding="16dp"
                    android:elevation="4dp" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_candidate_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp">

            <!-- Context label: insertion point or selected range -->
            <TextView
                android:id="@+id/tv_selected_range"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="center_vertical"
                android:textSize="12sp"
                android:textColor="@color/ime_status_text"
                android:singleLine="true" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="96dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/ll_candidates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="4dp" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- RMS / indeterminate progress -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:visibility="gone"
        android:progressTint="@color/ime_accent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <!-- Status pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="2dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="@color/ime_status_text"
            android:text="點擊麥克風開始語音輸入"
            android:background="@drawable/bg_ime_status_pill"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <!-- ── Shared operation area: Two rows ────────────────────── -->
    <!-- Row 1: ⇧ ◀ ▶ ⌫ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/btn_shift"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⇧"
            android:textSize="19sp"
            android:textColor="@color/ime_key_text"
            android:background="@drawable/key_bg" />

        <Space android:layout_width="6dp" android:layout_height="0dp" />

        <TextView
            android:id="@+id/btn_sel_expand_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="◀"
            android:textSize="17sp"
            android:textColor="@color/ime_key_text"
            android:background="@drawable/key_bg" />

        <Space android:layout_width="6dp" android:layout_height="0dp" />

        <TextView
            android:id="@+id/btn_sel_expand_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▶"
            android:textSize="17sp"
            android:textColor="@color/ime_key_text"
            android:background="@drawable/key_bg" />

        <Space android:layout_width="6dp" android:layout_height="0dp" />

        <TextView
            android:id="@+id/btn_backspace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌫"
            android:textSize="20sp"
            android:textColor="@color/ime_key_text"
            android:background="@drawable/key_bg" />
    </LinearLayout>

    <Space android:layout_width="0dp" android:layout_height="6dp" />

    <!-- Row 2: ⚙️ 詞彙/關閉 空格 ↵ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_settings"
            android:background="@drawable/key_bg"
            android:contentDescription="設定"
            android:scaleType="centerInside"
            android:padding="13dp" />

        <Space android:layout_width="6dp" android:layout_height="0dp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_dict_insert"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="詞彙"
                android:textSize="14sp"
                android:textColor="@color/ime_key_text"
                android:background="@drawable/key_bg" />

            <TextView
                android:id="@+id/btn_cancel_selection"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:visibility="gone"
                android:text="關閉"
                android:textSize="14sp"
                android:textColor="@color/ime_key_text"
                android:background="@drawable/key_bg" />
        </FrameLayout>

        <Space android:layout_width="6dp" android:layout_height="0dp" />

        <TextView
            android:id="@+id/btn_space"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="空格"
            android:textSize="14sp"
            android:textColor="@color/ime_key_text"
            android:background="@drawable/key_bg" />

        <Space android:layout_width="6dp" android:layout_height="0dp" />

        <TextView
            android:id="@+id/btn_enter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="↵"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/ime_accent_text"
            android:background="@drawable/key_enter_bg" />
    </LinearLayout>

</LinearLayout>
