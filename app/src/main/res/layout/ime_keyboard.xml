<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/ime_bg"
    android:paddingBottom="8dp">

    <!-- Transcription preview: long-press to select, then tap 套用詞彙 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/ime_preview_bg"
        android:fillViewport="true">
        <com.ping.voiceim.SelectableTextView
            android:id="@+id/tv_transcription"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="18sp"
            android:textColor="@color/ime_preview_text"
            android:hint="長按選取詞彙可套用自定義替換"
            android:textColorHint="#888888"
            android:singleLine="true" />
    </HorizontalScrollView>

    <!-- RMS / indeterminate progress -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="100"
        android:visibility="gone"
        android:progressTint="@color/ime_accent" />

    <!-- Status text -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center"
        android:textSize="12sp"
        android:textColor="@color/ime_status_text"
        android:text="點擊麥克風開始語音輸入" />

    <!-- ── Normal controls ──────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layout_normal_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Main row: backspace | mic | enter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/btn_backspace"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:src="@drawable/ic_backspace"
                android:background="@drawable/key_bg"
                android:contentDescription="退格"
                android:scaleType="center" />

            <Space android:layout_width="8dp" android:layout_height="0dp" />

            <ImageButton
                android:id="@+id/btn_mic"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_mic"
                android:background="@drawable/mic_bg"
                android:contentDescription="語音輸入"
                android:scaleType="centerInside"
                android:padding="14dp"
                android:elevation="4dp" />

            <Space android:layout_width="8dp" android:layout_height="0dp" />

            <ImageButton
                android:id="@+id/btn_enter"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:src="@drawable/ic_enter"
                android:background="@drawable/key_bg"
                android:contentDescription="確認/換行"
                android:scaleType="center" />
        </LinearLayout>

        <!-- Bottom action row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btn_clear"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="清除"
                android:textSize="14sp"
                android:textColor="@color/ime_key_text"
                android:background="@drawable/key_bg" />

            <Space android:layout_width="6dp" android:layout_height="0dp" />

            <TextView
                android:id="@+id/btn_commit"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="2"
                android:gravity="center"
                android:text="確認插入"
                android:textSize="14sp"
                android:textColor="@color/ime_accent_text"
                android:background="@drawable/commit_bg" />

            <Space android:layout_width="6dp" android:layout_height="0dp" />

            <TextView
                android:id="@+id/btn_space"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="空格"
                android:textSize="14sp"
                android:textColor="@color/ime_key_text"
                android:background="@drawable/key_bg" />

            <Space android:layout_width="6dp" android:layout_height="0dp" />

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_settings"
                android:background="@drawable/key_bg"
                android:contentDescription="詞彙設定"
                android:scaleType="centerInside"
                android:padding="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── Candidate panel (shown when text is selected) ──────────────── -->
    <LinearLayout
        android:id="@+id/layout_candidates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@color/ime_bg">

        <!-- Selected text label -->
        <TextView
            android:id="@+id/tv_selected_range"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="12sp"
            android:textColor="@color/ime_status_text"
            android:singleLine="true" />

        <!-- Candidate chips — wraps to multiple lines -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="96dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/ll_candidates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="4dp"
                app:chipSpacingVertical="2dp"
                xmlns:app="http://schemas.android.com/apk/res-auto" />
        </ScrollView>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btn_add_dict"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="新增替換詞"
                android:textSize="13sp"
                android:textColor="@color/ime_key_text"
                android:background="@drawable/key_bg" />

            <Space android:layout_width="6dp" android:layout_height="0dp" />

            <TextView
                android:id="@+id/btn_cancel_selection"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="取消選取"
                android:textSize="13sp"
                android:textColor="@color/ime_key_text"
                android:background="@drawable/key_bg" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
