<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="語音助理設定"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="請完成以下四項授權以啟動語音助理"
            android:textSize="16sp"
            android:textColor="#666666"
            android:layout_marginBottom="24dp" />

        <!-- 1. Microphone permission card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="麥克風權限"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#212121" />
                    <TextView
                        android:id="@+id/tv_mic_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未授權"
                        android:textSize="14sp"
                        android:textColor="@color/permission_missing" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"
                    android:text="SenseVoice 語音辨識需要存取麥克風"
                    android:textSize="14sp"
                    android:textColor="#757575" />
                <Button
                    android:id="@+id/btn_mic_permission"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="授予麥克風權限"
                    android:textSize="16sp"
                    android:backgroundTint="@color/blue_700" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 2. Overlay permission card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="懸浮視窗權限"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#212121" />
                    <TextView
                        android:id="@+id/tv_overlay_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未授權"
                        android:textSize="14sp"
                        android:textColor="@color/permission_missing" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"
                    android:text="允許助理氣泡顯示在所有應用程式上方"
                    android:textSize="14sp"
                    android:textColor="#757575" />
                <Button
                    android:id="@+id/btn_overlay_permission"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="前往授權"
                    android:textSize="16sp"
                    android:backgroundTint="@color/blue_700" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 3. Accessibility service card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="無障礙服務"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#212121" />
                    <TextView
                        android:id="@+id/tv_accessibility_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未啟用"
                        android:textSize="14sp"
                        android:textColor="@color/permission_missing" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"
                    android:text="允許助理讀取畫面內容並執行點擊操作"
                    android:textSize="14sp"
                    android:textColor="#757575" />
                <Button
                    android:id="@+id/btn_accessibility_permission"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="前往啟用"
                    android:textSize="16sp"
                    android:backgroundTint="@color/blue_700" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 4. Battery optimization card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/title_battery_opt"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#212121" />
                    <TextView
                        android:id="@+id/tv_battery_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未豁免"
                        android:textSize="14sp"
                        android:textColor="@color/permission_missing" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/desc_battery_opt_detail"
                    android:textSize="14sp"
                    android:textColor="#757575" />
                <Button
                    android:id="@+id/btn_battery_permission"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/btn_battery_exempt"
                    android:textSize="16sp"
                    android:backgroundTint="@color/blue_700" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Status -->
        <TextView
            android:id="@+id/tv_overall_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="請授予所有必要權限"
            android:textSize="15sp"
            android:textColor="@color/permission_missing"
            android:gravity="center" />

        <!-- Start/Stop -->
        <Button
            android:id="@+id/btn_toggle_service"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="啟動語音助理"
            android:textSize="20sp"
            android:enabled="false"
            android:backgroundTint="@color/blue_700" />

    </LinearLayout>
</ScrollView>
