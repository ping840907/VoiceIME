<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_bubble_mic_column"
    android:layout_width="60dp"
    android:layout_height="106dp"
    android:orientation="vertical"
    android:gravity="center_horizontal|bottom"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="2dp">

    <!-- Contextual Cancel / Undo X Button (38dp circular) -->
    <FrameLayout
        android:id="@+id/btn_bubble_x"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bubble_x_background"
        android:elevation="8dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="invisible">

        <ImageView
            android:id="@+id/iv_bubble_x_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_close"
            android:contentDescription="取消或復原" />
    </FrameLayout>

    <!-- Mic Button Container (56dp circular) -->
    <FrameLayout
        android:id="@+id/btn_bubble_mic"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bubble_background"
        android:elevation="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/iv_bubble_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mic"
            android:contentDescription="懸浮語音輸入" />

        <ProgressBar
            android:id="@+id/progress_bubble"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="#FFFFFF"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
