<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/panel_background"
    android:elevation="20dp"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <!-- Title Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="語音助理"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/btn_collapse"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="✕"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:gravity="center"
            android:padding="4dp" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#30FFFFFF"
        android:layout_marginBottom="16dp" />

    <!-- Status Text -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="點擊麥克風或鍵盤開始"
        android:textSize="17sp"
        android:textColor="@color/white_70"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- Action Button Row: mic + keyboard toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="12dp">

        <!-- Mic Button -->
        <TextView
            android:id="@+id/btn_mic"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/mic_button_background"
            android:text="話"
            android:textColor="@color/blue_700"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Keyboard toggle -->
        <TextView
            android:id="@+id/btn_keyboard_toggle"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/mic_button_background"
            android:text="⌨"
            android:textColor="@color/blue_700"
            android:textSize="24sp"
            android:gravity="center"
            android:contentDescription="切換文字輸入" />
    </LinearLayout>

    <!-- Text input row — initially hidden; shown when keyboard toggle is tapped -->
    <LinearLayout
        android:id="@+id/row_text_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/et_text_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_type_command"
            android:hintTextColor="#80FFFFFF"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:inputType="text"
            android:imeOptions="actionSend|flagNoExtractUi"
            android:maxLines="1"
            android:background="@null"
            android:paddingStart="4dp"
            android:paddingEnd="8dp" />

        <TextView
            android:id="@+id/btn_send_text"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:text="@string/btn_send"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#4D1565C0"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </LinearLayout>

    <!-- Thin separator above text input area -->
    <View
        android:id="@+id/divider_text_input"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#30FFFFFF"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

</LinearLayout>
